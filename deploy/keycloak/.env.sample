# Copy to .env and fill in. .env is gitignored — it holds secrets.
#   cp deploy/keycloak/.env.sample deploy/keycloak/.env
#
# This file is *sourced by the shell*, so any value containing spaces must be
# quoted (MDBOOK_ROLES below). Every variable can also come from the real
# environment instead, so CI can pass secrets without writing a file.
#
# Connection to the Keycloak admin API. Same variable names as the
# emr-keycloak scripts, so one .env can drive both.
KC_URL=https://sso.helex.dev
# Public issuer, when the admin API is reached privately (e.g. KC_URL points at
# localhost inside the compose network). Defaults to KC_URL.
#KC_PUBLIC_URL=https://sso.helex.dev
KC_ADMIN=admin
KC_ADMIN_PASS=
KC_REALM=mdbook

# The site this realm protects. SITE_URL is the public base of the mdbook site
# (including its base path); the client's redirect URI is derived from it as
# <SITE_URL>/auth/callback, which is the path `mdbook serve` listens on.
SITE_URL=https://tx.helex.dev/mdbook
SITE_ORIGIN=https://tx.helex.dev

# The public client mdbook authenticates with.
MDBOOK_CLIENT_ID=owlexicon

# Roles created on that client, and offered as groups (mdbook-<role>).
MDBOOK_ROLES="viewer editor admin"

# Role granted to every user who can log in. Leave empty to grant nothing by
# default — then a federated (e.g. Google) user authenticates successfully but
# is denied any role-gated section until someone assigns a group.
MDBOOK_DEFAULT_ROLE=

# --- Identity providers (optional) ---------------------------------------
# Google: create an OAuth client (type "Web application") and register
#   <KC_URL>/realms/<KC_REALM>/broker/google/endpoint
# as an authorized redirect URI, or Google answers redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict the account chooser to one Workspace domain (optional):
GOOGLE_HD=

# --- Test client (optional) ----------------------------------------------
# A service account used to verify enforcement without a browser or a password.
# Set the role it should hold; leave empty to skip creating it.
MDBOOK_TEST_ROLE=editor
