# Copy to .env and fill in. .env is gitignored — it holds secrets.
#   cp deploy/keycloak/.env.sample deploy/keycloak/.env
#
# This file is *sourced by the shell*, so any value containing spaces must be
# quoted (MDBOOK_ROLES below). Every variable can also come from the real
# environment instead, so CI can pass secrets without writing a file.
#
# Connection to the Keycloak admin API. Same variable names as the
# emr-keycloak scripts, so one .env can drive both.
KC_URL=https://sso.helex.dev
# Public issuer, when the admin API is reached privately (e.g. KC_URL points at
# localhost inside the compose network). Defaults to KC_URL.
#KC_PUBLIC_URL=https://sso.helex.dev
KC_ADMIN=admin
KC_ADMIN_PASS=
KC_REALM=mdbook

# The site this realm protects. SITE_URL is the public base of the mdbook site
# (including its base path); the client's redirect URI is derived from it as
# <SITE_URL>/auth/callback, which is the path `mdbook serve` listens on.
SITE_URL=https://tx.helex.dev/mdbook
SITE_ORIGIN=https://tx.helex.dev

# The public client mdbook authenticates with.
MDBOOK_CLIENT_ID=owlexicon

# Roles created on that client, and offered as groups (mdbook-<role>).
MDBOOK_ROLES="viewer editor admin"

# Role granted to every user who can log in. Leave empty to grant nothing by
# default — then a federated (e.g. Google) user authenticates successfully but
# is denied any role-gated section until someone assigns a group.
MDBOOK_DEFAULT_ROLE=

# First-broker-login flow bound to every identity provider. It decides what
# happens when a federated identity arrives for an account that already exists,
# which is how invitations work on the docs realms: a reader is pre-created by
# email and put in mdbook-viewer before first login. Point this at the flow
# setup-first-broker-login.sh builds — the reader confirms, is sent a link, and
# is linked only after following it (see docs/keycloak.md §3b). That flow needs
# the SMTP settings below; without them every invitation dead-ends.
# Empty = the built-in flow.
#KC_FIRST_BROKER_LOGIN_FLOW="docs-tx first broker login"

# Trust the address an identity provider returns as already verified. Default
# false; the docs realms set true. Both providers here return only verified
# addresses, so this trusts those two, not all. It marks a new reader's address
# verified on import — it never skips the email confirmation for an account that
# already exists.
#KC_IDP_TRUST_EMAIL=true

# --- Realm-level settings this script owns -------------------------------
# `ensure` skips a realm that already exists, so anything NOT listed in the
# realm body is silently absent from a REBUILT realm. SMTP matters most: the
# first-broker-login flow confirms account linking by email, so a realm rebuilt
# without a sender locks out every invited reader. When the realm already
# exists these are applied to it, and the script names what it changed.
KC_REALM_DISPLAY_NAME=
# Login theme — `helex` renders identity providers and no password form.
KC_LOGIN_THEME=
# true: the email IS the username, and neither can be edited by the reader —
# both become admin-only in the realm's user profile.
KC_EMAIL_AS_USERNAME=
# Declare personalIdentifier in the user profile: required | optional | empty
# (not managed). One value, country + national code as GovSSO issues it
# (EE39001010001), validated by pattern; the helex theme shows it as a country
# select and a code input. docs-tx: required. docs-emr: optional.
KC_PERSONAL_IDENTIFIER=
# Save user events (logins, account links, errors) in the realm: true | false |
# empty (not managed). Keycloak's log shows failures only, so this is the one
# record of a successful sign-in. Kept KC_EVENTS_EXPIRATION_DAYS days (default
# 90; 0 = forever) — events carry IP addresses. Both docs realms: true, 90.
KC_SAVE_EVENTS=
KC_EVENTS_EXPIRATION_DAYS=

# --- Mail (optional; empty SMTP_HOST omits smtpServer entirely) -----------
# Same variable names as the TEDY contract, so the estate has one vocabulary.
# The docs realms use the Google Workspace relay, which authorises by source
# IPv4 and needs no credentials — hence SMTP_AUTH=false and no username here.
# helex.org is DMARC p=reject with SPF include:_spf.google.com, so mail leaving
# by any other route is rejected rather than junked.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=
SMTP_REPLY_TO=
SMTP_AUTH=false
SMTP_STARTTLS=true
SMTP_SSL=false
# Only read when SMTP_AUTH=true.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Identity providers (optional) ---------------------------------------
# Google: create an OAuth client (type "Web application") and register
#   <KC_URL>/realms/<KC_REALM>/broker/google/endpoint
# as an authorized redirect URI, or Google answers redirect_uri_mismatch.
# Both values are written into Keycloak by setup-idp.sh; leaving the secret
# empty skips the provider instead of overwriting one already configured.
# Note: a value is read verbatim to end of line — no trailing "# comment".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict the account chooser to one Workspace domain (optional):
GOOGLE_HD=

# GitHub: register an OAuth App (org-owned, so it outlives one account) with
#   <KC_URL>/realms/<KC_REALM>/broker/github/endpoint
# as its Authorization callback URL. An OAuth App takes exactly ONE callback, so
# a second realm needs a second App — or a GitHub App, which allows ten.
#
# GitHub login cannot be restricted to an organisation: any GitHub account can
# complete the flow. On a role-gated site that is contained by the role, not by
# the provider — do not relax `access:` to `authenticated` while this is on.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Test client (optional) ----------------------------------------------
# A service account used to verify enforcement without a browser or a password.
# Set the role it should hold; leave empty to skip creating it.
MDBOOK_TEST_ROLE=editor
